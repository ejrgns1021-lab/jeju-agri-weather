{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/login",
        "function": {
          "functionId": "login",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/api/jejuweather",
        "function": {
          "functionId": "jejuweather",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/api/jejuprogress",
        "function": {
          "functionId": "jejuprogress",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/api/jejuforecast",
        "function": {
          "functionId": "jejuforecast",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/api/jejubrief",
        "function": {
          "functionId": "jejubrief",
          "region": "asia-northeast3"
        }
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python312",
      "ignore": [
        "venv",
        ".git",
        "__pycache__",
        "tests",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    }
  }
}
